{
  "name": "alnjoom-tina",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env TINA_PUBLIC_IS_LOCAL=true tinacms dev -c \"next dev -p 3355\"",
    "build": "node scripts/clean-index.js && cross-env TINA_PUBLIC_IS_LOCAL=false tinacms build --skip-cloud-checks && next build",
    "start": "cross-env TINA_PUBLIC_IS_LOCAL=false node server.js",
    "reindex": "node scripts/clean-index.js && cross-env TINA_PUBLIC_IS_LOCAL=false tinacms build --skip-cloud-checks",
    "editor": "node scripts/create-editor.js",
    "build:cloud": "cross-env TINA_PUBLIC_IS_LOCAL=false tinacms build && next build"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query": "^5.101.0",
    "@tinacms/cli": "^4.0.5",
    "@tinacms/datalayer": "^3.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "motion": "^14.9.0",
    "next": "16.2.9",
    "next-auth": "^4.24.15",
    "next-intl": "^4.13.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sqlite-level": "^2.1.1",
    "swiper": "^12.2.0",
    "tailwindcss": "^4",
    "tinacms": "^3.15.2",
    "tinacms-authjs": "^24.0.5"
  },
  "overrides": {
    "tinacms-authjs": {
      "next": "$next"
    }
  },
  "engines": {
    "node": ">=20.9"
  }
}
