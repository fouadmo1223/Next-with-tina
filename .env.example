# Copy to .env on the SERVER. Not needed for `npm run dev`.
# Two ways to run the dashboard on your server; fill in ONE section:
#   A. Self-hosted (DEPLOY.md): any git host, logins stored in the project.
#   B. TinaCloud (TINACLOUD.md): GitHub only, logins through tina.io.

# ============================ A. SELF-HOSTED ============================

# ---- Required ----
# A long random secret that signs editor logins. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=
# The site's public address, with https and no trailing slash.
NEXTAUTH_URL=https://your-domain.com

# ---- Git: every dashboard save/upload is committed and pushed to your GitLab/Bitbucket repo ----
# The branch the server's clone is on.
GIT_BRANCH=main
# Who the dashboard's commits are by.
GIT_AUTHOR_NAME=Alnjoom CMS
GIT_AUTHOR_EMAIL=cms@your-domain.com
# Set to false to commit on the server without pushing, or GIT_COMMIT=false to not use git at all.
# GIT_PUSH=false
# GIT_COMMIT=false

# ---- Optional ----
# Where Tina's index database lives (rebuilt from the files by every `npm run build`).
# TINA_DB_FILE=.tina-data/tina.db

# ============================ B. TINACLOUD ============================
# Setting the Client ID switches the project into TinaCloud mode (then build with `npm run build:cloud`).
# NEXT_PUBLIC_TINA_CLIENT_ID=
# TINA_TOKEN=
# GIT_BRANCH=main
